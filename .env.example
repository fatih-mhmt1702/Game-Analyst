# NextFest Insight Environment Configuration Example
# Copy this file to .env and configure your keys.
# NEVER commit your actual .env file or API credentials to version control.

# Application Server
PORT=8000
HOST=127.0.0.1
DEBUG=False
APP_ENV=development

# Database
DATABASE_PATH=backend/data/nextfest_insight.db

# Reddit API Credentials (Official Script/Web App via https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NextFestInsight:v1.0.0 (by /u/YourRedditUsername)

# X (Twitter) API v2 (Developer Portal via https://developer.x.com)
# Note: Basic/Pro tier required for search_recent. Free tier has limited endpoints.
X_BEARER_TOKEN=
X_API_KEY=
X_API_KEY_SECRET=

# Steam Community / Web API (Optional public discussion connector)
STEAM_WEB_API_KEY=

# AI Provider Integration (Optional - falls back to robust local rule-based NLP engine)
# Supported providers: local | openai | gemini
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=

# Statistical & Coverage Thresholds
LOW_SAMPLE_THRESHOLD=30
EVENT_DEFAULT_NAME=Steam Next Fest: October 2026
EVENT_START_DATE=2026-10-19
EVENT_END_DATE=2026-10-26
