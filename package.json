{
  "name": "nextfest-insight",
  "version": "1.0.0",
  "description": "Steam Next Fest Feedback Intelligence Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "backend": "py -3.13 -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000",
    "frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "desktop": "node electron/main.js",
    "start": "concurrently \"npm run backend\" \"npm run frontend\" \"wait-on http://127.0.0.1:8000/health && wait-on http://localhost:5173 && npm run desktop\"",
    "test:backend": "py -3.13 -m pytest backend/tests -v",
    "dist:win": "npm run build:frontend && npx electron-builder --win"
  },
  "build": {
    "appId": "com.nextfest.insight",
    "productName": "NextFest Insight",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!data/*.db"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "keywords": [
    "steam",
    "next-fest",
    "game-analytics",
    "feedback-intelligence",
    "desktop-app",
    "electron"
  ],
  "author": "NextFest Insight Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.1.1",
    "wait-on": "^8.0.2"
  }
}
